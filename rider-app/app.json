{
  "expo": {
    "name": "Routify",
    "slug": "delivery-planner",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/01cf61eb-26c7-4e49-866d-ee8b7c291ae2",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Delivery Rider uses the camera to capture proof-of-delivery photos.",
        "NSPhotoLibraryUsageDescription": "Delivery Rider needs photo library access to attach a delivery proof photo.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Delivery Rider converts your speech to text to fill in delivery details.",
        "NSMicrophoneUsageDescription": "Delivery Rider uses the microphone so you can add deliveries by voice."
      },
      "bundleIdentifier": "com.azaan890.deliveryrider"
    },
    "android": {
      "package": "com.azaan890.routify",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Delivery Rider uses your location to show your position and directions on an active route."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Delivery Rider uses the camera to capture proof-of-delivery photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Delivery Rider uses the camera to scan Eircodes and barcodes on packages."
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-mark-dark.png",
            "backgroundColor": "#0B1120"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Delivery Rider uses the microphone so you can add deliveries by voice.",
          "speechRecognitionPermission": "Delivery Rider converts your speech to text to fill in delivery details."
        }
      ],
      "./plugins/withSingleTopActivity",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "01cf61eb-26c7-4e49-866d-ee8b7c291ae2"
      }
    },
    "owner": "azaan890"
  }
}
