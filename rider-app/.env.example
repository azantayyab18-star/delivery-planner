# Routify API the app talks to (your PC's LAN address while developing on a phone)
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# RevenueCat public SDK keys (RevenueCat > Project settings > API keys). The Test Store key (test_...) is used only in
# development builds - the SDK crashes a release build that uses it. Release builds use the platform keys.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Crash/error reporting in release builds (Sentry project for React Native). Empty = off.
EXPO_PUBLIC_SENTRY_DSN=

# Continue with Google (Android): the Web OAuth client id from Google Cloud (the API checks tokens issued to it;
# set the same id in the backend's GOOGLE_SIGNIN_CLIENT_IDS). Unset: the Google button is hidden.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Development only: a fixed position instead of GPS, "latitude,longitude" (e.g. central Dublin). Unset: real GPS.
# EXPO_PUBLIC_TEST_LOCATION=53.3498,-6.2603
