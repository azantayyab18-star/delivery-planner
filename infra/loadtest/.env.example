# Load test configuration. Copy to .env and fill in.
#
# The load tests may only run against a STAGING environment. The scripts refuse any
# host that does not look like a staging host, and always refuse the known
# production hosts.

# The API to load. No default: the scripts stop when this is missing.
# routify-api-swae is our development / client-testing server on Render (it shares the Neon database with local
# development, and seeding adds test riders there).
LOADTEST_BASE_URL=https://routify-api-swae.onrender.com

# What a staging hostname must match (regular expression, case-insensitive). Our test server's name has no "staging"
# in it, so it is allowed by name; a future routify-api-staging host still matches "staging".
# Single quotes: scripts/run.sh loads this file as shell, where | and $ would otherwise be read as shell syntax.
STAGING_HOST_PATTERN='staging|^routify-api-swae\.onrender\.com$'

# Production hostnames that must never be loaded (comma separated).
PROD_HOSTS=routify-api.onrender.com,api.routify.ie,www.routify.ie,routify.ie

# The rider file (access tokens; git-ignored).
RIDER_FILE=infra/loadtest/data/riders.json

# Seeding.
LOADTEST_EMAIL_DOMAIN=example.test
LOADTEST_PASSWORD=LoadTest!2026
# mock = the staging mock store activates the plan; admin = an owner_admin sets it; none = no plan.
LOADTEST_ACTIVATE=mock
LOADTEST_ADMIN_EMAIL=
LOADTEST_ADMIN_PASSWORD=

# k6 knobs.
VUS=20
RAMP=30s
STEADY=2m
SLEEP=1
