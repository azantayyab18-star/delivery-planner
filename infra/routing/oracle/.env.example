# Copy to .env on the Oracle server and fill in. Never commit the filled-in .env.

# Public hostname with a free HTTPS certificate. Without a domain, use the server's public IP through sslip.io,
# e.g. IP 140.238.12.34 -> 140-238-12-34.sslip.io (it resolves to that IP; Let's Encrypt issues a certificate for it).
ROUTING_HOST=140-238-12-34.sslip.io
# Let's Encrypt contact address (expiry notices).
ACME_EMAIL=you@example.com

# The login the backend uses. Make the hash with:
#   docker run --rm caddy:2.8.4 caddy hash-password --plaintext 'a-long-random-password'
# Keep the hash in single quotes: it contains "$", which docker compose would otherwise read as a variable.
ROUTING_USER=routify
ROUTING_PASSWORD_HASH='$2a$14$replace-with-the-hash-from-the-command-above'

# Images (both multi-arch: amd64 and arm64) and OSRM's table limit (points per request).
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v26.4.0
VROOM_IMAGE=ghcr.io/vroom-project/vroom-docker:v1.14.0
OSRM_MAX_TABLE_SIZE=2500
