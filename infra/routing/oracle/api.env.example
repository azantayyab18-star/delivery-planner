# The Routify API's settings on the Oracle server: copy to api.env next to docker-compose.yml. Never commit api.env.
# OSRM/VROOM URLs, PORT and STORAGE_DIR are set in docker-compose.yml (the containers on this server).
NODE_ENV=production
LOG_LEVEL=info
# Caddy is the one proxy in front of the API: trust one hop so rate limits apply per client.
TRUST_PROXY=1
CORS_ORIGINS=http://localhost:5173

# Neon: pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# python -c "import secrets; print(secrets.token_hex(32))" for each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FILE_SIGNING_SECRET=

ROUTING_PROVIDER=osrm
GEOCODING_PROVIDER=google
GOOGLE_MAPS_API_KEY=
GOOGLE_SIGNIN_CLIENT_IDS=

EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_FROM_NAME=Routify
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# Testing: the mock store activates plans without payment. Remove mock and ALLOW_MOCK_STORE before launch.
PAYMENT_STORES=revenuecat,mock
ALLOW_MOCK_STORE=true
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT=routify_pro
